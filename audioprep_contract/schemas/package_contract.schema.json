{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audioprep.local/schemas/package-contract.v1.json",
  "title": "AudioPrep package-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "design_revision",
    "name",
    "layer",
    "depends_on",
    "responsibility",
    "public_surface",
    "must_not",
    "maturity",
    "repository_model"
  ],
  "properties": {
    "schema": {
      "const": "audioprep.package-contract.v1"
    },
    "design_revision": {
      "const": "R2.1.5.07"
    },
    "name": {
      "type": "string",
      "pattern": "^audioprep-[a-z0-9-]+$"
    },
    "layer": {
      "type": "integer",
      "minimum": 0
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^audioprep-[a-z0-9-]+$"
      }
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "public_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_not": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maturity": {
      "const": "PLANNING_ONLY"
    },
    "repository_model": {
      "const": "single-monorepo-unified-version"
    }
  }
}
