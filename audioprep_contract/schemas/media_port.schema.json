{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audioprep.local/schemas/media-port.v2.json",
  "title": "AudioPrep MediaPortSpec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "role",
    "media_kind"
  ],
  "properties": {
    "artifact_type": {
      "enum": [
        "audio",
        "timeline",
        "metrics",
        "metadata",
        "candidate"
      ]
    },
    "role": {
      "enum": [
        "SOURCE_MEDIA",
        "QUALITY_MASTER",
        "ANALYSIS_COPY",
        "PIPELINE_AUDIO",
        "ASR_SEGMENT",
        "CANDIDATE",
        "CHECKPOINT",
        "CACHE",
        "TIMELINE",
        "METRICS",
        "METADATA",
        "DELIVERY_SEGMENT"
      ]
    },
    "media_kind": {
      "enum": [
        "audio",
        "timeline",
        "metrics",
        "metadata",
        "candidate"
      ]
    },
    "cardinality": {
      "enum": [
        "required-single",
        "optional-single",
        "variadic"
      ],
      "default": "required-single"
    },
    "container": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sample_rate_hz": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 8000
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "sample_format": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "timeline_alignment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SOURCE_ALIGNED",
          "MAPPED"
        ]
      }
    }
  }
}
